{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": null,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["vite/client", "node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/core/public-api.ts", "src/core/models", "src/core/utils", "src/react", "src/core/tokens"],
  "exclude": ["src/**/*.test.ts"]
}
