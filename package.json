{
  "name": "@argousiere/vespertina-design-system",
  "version": "0.2.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argousiere/vespertina-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/styles.css": "./dist/core/styles.css",
    "./core/tokens.css": "./dist/core/tokens.css",
    "./core/tokens": {
      "types": "./dist/core/tokens/tokens.d.ts",
      "import": "./dist/core/token-values.js",
      "default": "./dist/core/token-values.js"
    },
    "./core/fonts/*": "./dist/core/fonts/*",
    "./core/images/*": "./dist/core/images/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build-design-tokens": "node scripts/build-css-from-tokens-source.ts",
    "build": "npm run build-design-tokens && tsc -b && vite build -c vite.lib.config.ts",
    "build-design-tokens:watch": "node scripts/build-css-from-tokens-source.ts --watch",
    "build:watch": "npm run build-design-tokens && tsc -b && (npm run build-design-tokens:watch & vite build -c vite.lib.config.ts --watch)",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^16.5.0",
    "marked": "^18.1.1",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "prettier-plugin-css-order": "^2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  }
}
